<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_transfer_wizard_form" model="ir.ui.view"><field name="name">flousflow.whatsapp.transfer.wizard.form</field><field name="model">flousflow.whatsapp.transfer.wizard</field><field name="arch" type="xml"><form string="Transfer Conversation"><group><field name="conversation_id" readonly="1"/><field name="target_user_id"/><field name="target_team_id"/><field name="reason" placeholder="Required transfer reason..."/></group><footer><button name="action_transfer" type="object" string="Transfer" class="oe_highlight"/><button string="Cancel" special="cancel"/></footer></form></field></record>
    <record id="view_whatsapp_takeover_wizard_form" model="ir.ui.view"><field name="name">flousflow.whatsapp.takeover.wizard.form</field><field name="model">flousflow.whatsapp.takeover.wizard</field><field name="arch" type="xml"><form string="Take Over Conversation"><group><field name="conversation_id" readonly="1"/><field name="reason" placeholder="Required takeover reason..."/></group><footer><button name="action_takeover" type="object" string="Take Over" class="oe_highlight"/><button string="Cancel" special="cancel"/></footer></form></field></record>
    <record id="view_whatsapp_handover_wizard_form" model="ir.ui.view"><field name="name">flousflow.whatsapp.handover.wizard.form</field><field name="model">flousflow.whatsapp.handover.wizard</field><field name="arch" type="xml"><form string="Hand Over Conversations"><group><field name="employee_id" readonly="1"/><field name="target_user_id"/><field name="reason" placeholder="Required handover reason..."/></group><footer><button name="action_handover" type="object" string="Hand Over" class="oe_highlight"/><button string="Cancel" special="cancel"/></footer></form></field></record>
    <record id="view_whatsapp_lead_wizard_form" model="ir.ui.view">
        <field name="name">flousflow.whatsapp.lead.wizard.form</field>
        <field name="model">flousflow.whatsapp.lead.wizard</field>
        <field name="arch" type="xml">
            <form string="Create CRM Lead">
                <group>
                    <field name="conversation_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="partner_id" readonly="1" invisible="not partner_id"/>
                    <field name="phone" readonly="1"/>
                    <field name="email" widget="email"/>
                    <field name="contact_name" readonly="partner_id"/>
                    <field name="name"/>
                    <field name="summary" placeholder="Required summary of the customer's request and conversation..."/>
                    <field name="notes" placeholder="Agent notes and agreed next steps..."/>
                    <field name="team_id" domain="[('company_id', 'in', [False, company_id])]"/>
                    <field name="user_id" domain="[('share', '=', False)]"/>
                    <field name="priority" widget="priority"/>
                </group>
                <footer>
                    <button name="action_create_lead" type="object" string="Create &amp; Open" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_whatsapp_cleanup_wizard_form" model="ir.ui.view">
        <field name="name">flousflow.whatsapp.cleanup.wizard.form</field>
        <field name="model">flousflow.whatsapp.cleanup.wizard</field>
        <field name="arch" type="xml">
            <form string="Clean Synchronized WhatsApp Data">
                <div class="alert alert-danger" role="alert">
                    This permanently deletes WhatsApp messages and conversations synchronized through the selected number.
                    Existing business contacts are protected. Disconnect the wrong connector session before cleanup;
                    verify the correct pairing before re-enabling this number.
                </div>
                <group>
                    <field name="number_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <group string="Records found" col="3">
                    <field name="message_count" readonly="1"/>
                    <field name="conversation_count" readonly="1"/>
                    <field name="contact_count" readonly="1"/>
                </group>
                <group>
                    <field name="delete_module_contacts"/>
                    <field name="disable_number_after_cleanup"/>
                    <field name="expected_confirmation" readonly="1" string="Type this confirmation"/>
                    <field name="confirmation" placeholder="DELETE + phone number"/>
                </group>
                <footer>
                    <button name="action_cleanup" type="object" string="Delete Synchronized Data"
                            class="btn-danger" confirm="This operation cannot be undone. Continue?"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
