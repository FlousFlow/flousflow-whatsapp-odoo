<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_sale_order_send_wizard_form" model="ir.ui.view">
        <field name="name">flousflow.whatsapp.sale.order.send.wizard.form</field>
        <field name="model">flousflow.whatsapp.sale.order.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Quotation by WhatsApp">
                <group>
                    <field name="sale_order_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="allowed_number_ids" invisible="1"/>
                    <field name="number_id" domain="[('id', 'in', allowed_number_ids)]"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="customer_phone"/>
                    <field name="caption" placeholder="Optional message accompanying the quotation PDF..."/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send via WhatsApp" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
