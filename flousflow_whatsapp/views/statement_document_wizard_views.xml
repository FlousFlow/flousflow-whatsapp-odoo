<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_statement_document_wizard_form" model="ir.ui.view">
        <field name="name">flousflow.whatsapp.statement.document.wizard.form</field>
        <field name="model">flousflow.whatsapp.statement.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Customer Statement by WhatsApp">
                <group>
                    <field name="conversation_id" readonly="1"/>
                    <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="account_type"/>
                    <field name="target_move"/>
                    <field name="include_reconciled"/>
                    <field name="caption" placeholder="Optional message accompanying the PDF..."/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
