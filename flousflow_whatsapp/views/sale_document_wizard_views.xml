<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_sale_document_wizard_form" model="ir.ui.view">
        <field name="name">flousflow.whatsapp.sale.document.wizard.form</field>
        <field name="model">flousflow.whatsapp.sale.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Quotation by WhatsApp">
                <group>
                    <field name="conversation_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="commercial_partner_id" invisible="1"/>
                    <field name="sale_order_id" domain="[('company_id', '=', company_id), ('partner_id.commercial_partner_id', '=', commercial_partner_id)]"/>
                    <field name="caption" placeholder="Optional message accompanying the PDF..."/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
