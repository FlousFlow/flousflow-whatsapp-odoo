<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="module_category_whatsapp_crm" model="ir.module.category">
        <field name="name">WhatsApp CRM</field>
        <field name="sequence">45</field>
    </record>
    <record id="privilege_whatsapp_crm" model="res.groups.privilege">
        <field name="name">WhatsApp CRM</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="module_category_whatsapp_crm" />
    </record>
    <record id="group_whatsapp_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_whatsapp_crm" />
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman'))]" />
    </record>
    <record id="group_whatsapp_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_whatsapp_crm" />
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_agent'))]" />
    </record>
    <record id="group_whatsapp_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_whatsapp_crm" />
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_supervisor'))]" />
    </record>
    <record id="group_whatsapp_executive" model="res.groups">
        <field name="name">Executive Viewer</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_whatsapp_crm" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>